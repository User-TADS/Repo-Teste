{
  "info":{"name":"DevShowcase API","description":"Execute as requisições em ordem; os IDs são salvos pela coleção.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://127.0.0.1:8000"}],
  "item":[
    {"name":"1. Cadastrar perfil","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Ada Lovelace\",\"bio\":\"Desenvolvedora de software\",\"github_url\":\"https://github.com/ada-lovelace\"}"},"url":"{{baseUrl}}/api/profiles"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Criado', function(){pm.response.to.have.status(201)});","pm.collectionVariables.set('profileId', pm.response.json().id);"]}}]},
    {"name":"2. Buscar perfil","request":{"method":"GET","url":"{{baseUrl}}/api/profiles/{{profileId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Encontrado', function(){pm.response.to.have.status(200)});"]}}]},
    {"name":"3. Cadastrar tecnologia","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"FastAPI\",\"description\":\"Framework web para APIs Python\"}"},"url":"{{baseUrl}}/api/technologies"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Criada', function(){pm.response.to.have.status(201)});","pm.collectionVariables.set('technologyId', pm.response.json().id);"]}}]},
    {"name":"4. Listar tecnologias","request":{"method":"GET","url":"{{baseUrl}}/api/technologies"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Lista retornada', function(){pm.response.to.have.status(200)});"]}}]},
    {"name":"5. Cadastrar projeto","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"title\":\"DevShowcase API\",\"profile_id\":\"{{profileId}}\",\"technology_ids\":[\"{{technologyId}}\"],\"repository_url\":\"https://github.com/exemplo/devshowcase-api\",\"demo_url\":\"https://example.com\"}"},"url":"{{baseUrl}}/api/projects"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Criado', function(){pm.response.to.have.status(201)});","pm.collectionVariables.set('projectId', pm.response.json().id);"]}}]},
    {"name":"6. Listar projetos","request":{"method":"GET","url":"{{baseUrl}}/api/projects"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Lista retornada', function(){pm.response.to.have.status(200)});"]}}]},
    {"name":"7. Validar título obrigatório","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"title\":\"\",\"profile_id\":\"{{profileId}}\"}"},"url":"{{baseUrl}}/api/projects"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Vazio rejeitado', function(){pm.response.to.have.status(422)});"]}}]}
  ]
}
